# AMBIENTE DE DESARROLLO. Copiar a env/dev.env (o ejecutar: node tools/init-env.js dev)
APP_ENV=development
DB_NAME=pnk_dev
DB_USER=pnk
DB_PASSWORD=CAMBIAR_PASSWORD
SESSION_SECRET=CAMBIAR_SECRETO
COOKIE_SECURE=false
TRUST_PROXY=0
# datos de demostración: catálogo de restaurantes y usuarios de laboratorio (admin@gmail.com / admin01, alondra@gmail.com / alondra01)
SEED_CATALOGO=true
SEED_USUARIOS_DEMO=true
