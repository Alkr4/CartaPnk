# AMBIENTE DE PRODUCCIÓN. Copiar a env/prod.env (o ejecutar: node tools/init-env.js prod). NUNCA subir env/prod.env a Git.
APP_ENV=production
DB_NAME=pnk_prod
DB_USER=pnk
DB_PASSWORD=CAMBIAR_PASSWORD
SESSION_SECRET=CAMBIAR_SECRETO
# Producción se sirve por HTTPS (Cloudflare): cookie Secure + HSTS, y un proxy de confianza delante de la app
COOKIE_SECURE=true
TRUST_PROXY=1
# catálogo de restaurantes visible; SIN usuarios de demostración (sus contraseñas son conocidas)
SEED_CATALOGO=true
SEED_USUARIOS_DEMO=false
# primer administrador (mínimo 12 caracteres). Se crea sólo si no existe.
ADMIN_EMAIL=admin@ejemplo.cl
ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD

# Publicación en la red:
#  a) Cloudflare Tunnel (recomendado, no abre puertos): APP_BIND=127.0.0.1 y definir TUNNEL_TOKEN
#  b) Cloudflare apuntando a la IP pública del EC2:    APP_BIND=0.0.0.0 y APP_PORT=80
APP_BIND=127.0.0.1
APP_PORT=3000
TUNNEL_TOKEN=
