# AMBIENTE DE QA. Copiar a env/qa.env (o ejecutar: node tools/init-env.js qa)
# Se comporta como producción (secretos obligatorios, sin valores por defecto) pero con datos de demostración.
APP_ENV=qa
DB_NAME=pnk_qa
DB_USER=pnk
DB_PASSWORD=CAMBIAR_PASSWORD
SESSION_SECRET=CAMBIAR_SECRETO
# QA se prueba por HTTP en localhost: la cookie no puede ser Secure
COOKIE_SECURE=false
TRUST_PROXY=0
SEED_CATALOGO=true
SEED_USUARIOS_DEMO=true
