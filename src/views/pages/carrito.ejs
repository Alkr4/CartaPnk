<%- include('../partials/head', { titulo }) %>
<section>
    <div class="container contendor">
      <div class="row">
        <div class="col-lg-4">
          <div style="text-align: center;">
            <div class="d-flex">
              <img class="logosintituciones" src="/img/logo.png" width="170px" alt="">
            </div><br><br>
          </div>
        </div>
        <div class="col-lg-4">
          <div style="text-align: center;">
            <% if (restaurante.foto) { %>
              <img class="logosintituciones" src="<%= urlFoto(restaurante.id, restaurante.foto) %>" width="170px" alt="">
            <% } else { %>
              <img class="logosintituciones" src="/img/logo_empresa_comodin.png" width="170px" alt="">
            <% } %>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="carro">
            <div class="d-flex float-end">
              <a class="volver" href="/restaurantes/<%= restaurante.id %>">
              Volver a la Carta
              </a>&nbsp;&nbsp;
              <a class="limpiar" href="#">
              Eliminar Todo
              </a>
            </div>
          </div>
        </div>
    </div>
  </section>
  <section>
    <div class="container contendor">
      <div class="row">
        <div class="col-lg-12">
         <h4 class="intro-title" style="text-align: center">Productos Agregados para Solicitar</h4>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="container contendor">
      <div class="row">
        <div class="col-lg-12">
               <table class="table table-hover table-lg">
                  <thead>
                     <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Producto</th>
                        <th scope="col">Precios</th>
                        <th scope="col">Acción</th>
                     </tr>
                  </thead>
                  <tbody>
                     <% for (const p of items) { %>
                     <tr>
                        <th scope="row"><%= p.id %></th>
                        <td><%= p.nombre %></td>
                        <td><%= monedaChilena(p.precio) %></td>
                        <td>
                          <a class="elim" data-posicion="<%= p.posicion %>" href="#">
                            <%- include('../partials/icono-basurero') %>
                          </a>
                        </td>
                     </tr>
                     <% } %>
                  </tbody>
                </table>
              <div>
                <hr><br>
                <h3 class="price-tag text-center">¡¡¡Si estas listo con tu pedido, llama al garzón para solicitarlo!!!</h3>
              </div>
        </div>
      </div>
    </div>
  </section>

<%- include('../partials/footer-carrito') %>

  <script src="/vendors/jquery/jquery-3.7.1.min.js"></script>
  <script src="/vendors/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/controladorajax.js"></script>
</body>
</html>
