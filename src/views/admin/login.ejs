<%- include('partials/head', { titulo }) %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-sm-8 col-md-5 col-lg-4">
      <div class="card login-card shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-3"><img src="/img/logo.png" width="150" alt=""></div>
          <h1 class="h5 text-center mb-3">Acceso de administración</h1>
          <% if (locals.flash) { %><div class="alert alert-danger py-2" role="alert"><%= flash %></div><% } %>
          <form action="/admin/login" method="post" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="email">Correo</label>
              <input class="form-control" type="email" id="email" name="email" maxlength="255" autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
              <label class="form-label" for="password">Contraseña</label>
              <input class="form-control" type="password" id="password" name="password" maxlength="1024" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-dark w-100">Ingresar</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js"></script>
</body>
</html>
