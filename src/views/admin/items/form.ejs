<%- include('../partials/head', { titulo }) %>
<%- include('../partials/nav') %>
<h1 class="h3 mb-3"><%= titulo %></h1>
<form action="<%= accion %>" method="post" enctype="multipart/form-data" class="card card-body" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row">
    <%- include('../partials/campo', { nombre: 'nombre', etiqueta: 'Nombre', requerido: true, max: 100, col: 'col-md-8' }) %>
    <%- include('../partials/campo', { nombre: 'precio', etiqueta: 'Precio ($)', tipo: 'number', col: 'col-md-4' }) %>
    <%- include('../partials/campo', { nombre: 'descripcion', etiqueta: 'Descripción', tipo: 'textarea', max: 300, col: 'col-12' }) %>
    <%- include('../partials/campo', { nombre: 'observaciones', etiqueta: 'Observaciones', tipo: 'textarea', max: 300, col: 'col-12' }) %>
    <%- include('../partials/campo', { nombre: 'tiempo', etiqueta: 'Tiempo de preparación', max: 100, col: 'col-md-6' }) %>
    <%- include('../partials/campo', { nombre: 'puntuacion', etiqueta: 'Puntuación (0 a 5)', tipo: 'number', col: 'col-md-3' }) %>
    <%- include('../partials/campo', { nombre: 'orden', etiqueta: 'Orden', tipo: 'number', col: 'col-md-3' }) %>
  </div>
  <%- include('../partials/check', { nombre: 'visible', etiqueta: 'Visible en el sitio' }) %>
  <%- include('../partials/check', { nombre: 'destacado', etiqueta: 'Destacado (carrusel de menús destacados)' }) %>
  <%- include('../partials/foto', { actual: item ? item.foto : null, restauranteId: item ? item.restaurante_id : 0 }) %>
  <div><button class="btn btn-dark" type="submit">Guardar</button> <a class="btn btn-outline-secondary" href="<%= volver %>">Cancelar</a></div>
</form>
<%- include('../partials/foot') %>
