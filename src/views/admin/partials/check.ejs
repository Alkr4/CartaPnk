<div class="form-check form-switch mb-2">
  <input class="form-check-input" type="checkbox" role="switch" id="f-<%= nombre %>" name="<%= nombre %>" <%= valores[nombre] === 'on' || valores[nombre] === true ? 'checked' : '' %>>
  <label class="form-check-label" for="f-<%= nombre %>"><%= etiqueta %></label>
</div>
