<%# Campo de imagen (JPG/PNG/WEBP, máx. 2 MB). `actual` = foto guardada (o null) %>
<div class="mb-3">
  <label class="form-label" for="f-foto">Imagen (JPG, PNG o WEBP, máx. 2 MB)</label>
  <% if (actual) { %>
    <div class="mb-2"><img class="thumb-lg" src="<%= urlFoto(restauranteId, actual) %>" alt="Imagen actual"></div>
  <% } %>
  <input class="form-control" type="file" id="f-foto" name="foto" accept="image/jpeg,image/png,image/webp">
  <% if (actual) { %>
    <div class="form-check mt-2">
      <input class="form-check-input" type="checkbox" id="f-quitar" name="quitar_foto">
      <label class="form-check-label" for="f-quitar">Quitar la imagen actual</label>
    </div>
  <% } %>
</div>
